# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The web app connects with a READ-ONLY role. It never needs write access.
DATABASE_URL=postgres://decode_web:decode_web@localhost:5432/decode_health

# Ingest + migrations connect with the owner role (creates partitions, loads data).
INGEST_DATABASE_URL=postgres://decode:decode@localhost:5432/decode_health

# ---------------------------------------------------------------------------
# Ingest pipeline
# ---------------------------------------------------------------------------
# Local working directory for downloads, parse output, and the object-storage cache.
# Git-ignored. Hospital price files must never be committed.
DATA_DIR=./.data

# Where raw hospital files are kept: "local" (under DATA_DIR) or "s3" (R2/S3/MinIO).
STORAGE_BACKEND=local
# Cloudflare R2 example (create an R2 API token with Object Read & Write on this bucket):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=decode-health-raw
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# Hard ceiling on a single downloaded file (bytes). Some hospital files are 10+ GB.
INGEST_MAX_FILE_BYTES=21474836480

# Identify ourselves politely to hospital web servers.
INGEST_USER_AGENT=DecodeHealthBot/0.1 (+https://example.org/bot; contact@example.org)
