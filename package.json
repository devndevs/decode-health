{
  "name": "decode-health",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @decode-health/web dev",
    "build": "pnpm --filter @decode-health/web build",
    "start": "pnpm --filter @decode-health/web start",
    "typecheck": "pnpm -r typecheck",
    "check:files": "node scripts/check-no-data-files.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "ingest": "tsx --env-file-if-exists=.env packages/ingest/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
